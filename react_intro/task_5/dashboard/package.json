{
  "name": "dashboard",
  "version": "1.0.0",
  "description": "Holberton dashboard built with Webpack and Babel",
  "main": "src/index.js",
  "scripts": {
    "start": "webpack-dev-server --mode development --config config/webpack.config.js",
    "build": "webpack --mode production --config config/webpack.config.js",
    "test": "jest"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/config/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less)$": "<rootDir>/config/styleMock.js",
      "\\.(jpg|jpeg|png|gif|svg|ico)$": "<rootDir>/config/fileMock.js"
    }
  },
  "license": "ISC",
  "dependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@wojtekmaj/enzyme-adapter-react-17": "^0.8.0",
    "babel-jest": "^27.5.1",
    "babel-loader": "^8.4.1",
    "cheerio": "1.0.0-rc.12",
    "css-loader": "^5.2.7",
    "enzyme": "^3.11.0",
    "file-loader": "^6.2.0",
    "image-webpack-loader": "^7.0.1",
    "jest": "^27.5.1",
    "style-loader": "^2.0.0",
    "webpack": "^5.112.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.15.2"
  }
}
